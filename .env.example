# =========================================================
#  Variáveis de ambiente — copie para `.env` e preencha.
#  O `.env` NUNCA vai para o Git (já está no .gitignore).
# =========================================================

# URL pública do projeto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon public" (Settings → API → Project API keys → anon public)
# Pode ficar no navegador: quem protege os dados é o RLS, não o segredo dela.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------
# NÃO coloque aqui, nunca:
#   - a senha do banco de dados (só para conexão direta ao Postgres,
#     via psql / CLI de migração — jamais no frontend)
#   - a chave `service_role` (ignora o RLS: quem tiver ela lê e apaga tudo)
# ---------------------------------------------------------
